# Copie para .env e preencha depois. Nenhum envio ocorre sem SMTP_HOST e SMTP_FROM.
# SMTP_PORT=587 usa STARTTLS; SMTP_SECURE=true usa TLS direto (normalmente porta 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartScrap"

# Opcionais para o aplicativo local:
# PORT=3001
# DB_PATH=data/smartscrap.sqlite
# SEED_DEMO=true
