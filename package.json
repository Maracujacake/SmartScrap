{
  "name": "smartscrap-exchange",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "share": "node scripts/share.mjs",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"scripts/*.mjs\" \"tests/*.js\" vite.config.js package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"scripts/*.mjs\" \"tests/*.js\" vite.config.js package.json .prettierrc.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  }
}
